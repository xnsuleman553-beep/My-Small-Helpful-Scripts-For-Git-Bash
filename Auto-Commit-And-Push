if [ -z "$(git status --porcelain)" ]; then
    echo "No changes to commit."
  
    if [[ "$(git status -sb)" != *"ahead"* ]]; then
        echo "Everything is up to date"
        exit 0
    fi
else
    read -p "Enter commit message: " msg
    git add . 
    git commit -m "$msg"
fi

git push
echo "Pushed to remote repository"